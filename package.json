{
	"name": "waw-notes",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=24.21.0"
	},
	"scripts": {
		"format:check": "biome format .",
		"format": "biome format --write .",
		"lint": "biome lint --error-on-warnings .",
		"build:shared": "pnpm --filter @waw-notes/api-contract run build && pnpm --filter @waw-notes/core run build",
		"typecheck": "pnpm build:shared && pnpm -r run typecheck",
		"test:unit": "pnpm build:shared && pnpm -r run test",
		"build": "pnpm -r run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/node": "24.19.2",
		"typescript": "5.9.3",
		"vitest": "5.1.1"
	}
}
