{
	"name": "@waw-notes/client",
	"version": "0.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
		"web": "EXPO_NO_TELEMETRY=1 expo start --web",
		"build": "EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "jest --ci --watchman=false"
	},
	"dependencies": {
		"@expo/metro-runtime": "58.0.17",
		"expo": "~58.0.26",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-web": "0.21.4"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.88.1",
		"@testing-library/react-native": "14.1.0",
		"@types/jest": "30.0.0",
		"@types/react": "~19.3.0",
		"jest": "30.5.2",
		"jest-expo": "~58.0.15",
		"react-server-dom-webpack": "19.3.0",
		"test-renderer": "1.3.1"
	},
	"jest": {
		"preset": "jest-expo"
	}
}
