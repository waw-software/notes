{
	"name": "@waw-notes/client",
	"version": "0.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"ios": "EXPO_NO_TELEMETRY=1 expo start --ios --localhost",
		"web": "EXPO_NO_TELEMETRY=1 expo start --web --localhost",
		"build": "EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "jest --ci --watchman=false"
	},
	"dependencies": {
		"@expo/dom-webview": "~58.0.2",
		"@expo/metro-runtime": "58.0.17",
		"@milkdown/kit": "7.23.0",
		"expo": "~58.0.26",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-web": "0.21.4"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.88.1",
		"@testing-library/react-native": "14.1.0",
		"@types/jest": "30.0.0",
		"@types/react": "~19.3.0",
		"jest": "30.5.2",
		"jest-expo": "~58.0.15",
		"react-server-dom-webpack": "19.3.0",
		"test-renderer": "1.3.1"
	},
	"jest": {
		"projects": [
			{
				"preset": "jest-expo",
				"testPathIgnorePatterns": [
					"/node_modules/",
					"\\.dom\\.test\\.tsx?$"
				]
			},
			{
				"preset": "jest-expo/web",
				"testMatch": [
					"**/*.dom.test.ts",
					"**/*.dom.test.tsx"
				],
				"testEnvironmentOptions": {
					"customExportConditions": [
						"browser",
						"import"
					]
				},
				"transformIgnorePatterns": [
					"/node_modules/(?!(\\.pnpm|react-native|@react-native|expo|@expo)|(@milkdown/[^/]+|@ocavue/[^/]+|@codemirror/[^/]+|@lezer/[^/]+|@marijn/[^/]+|prosemirror-[^/]+|remark(-[^/]+)?|mdast-util-[^/]+|micromark(-[^/]+)?|unist-util-[^/]+|unified|bail|trough|vfile(-message)?|devlop|is-plain-obj|zwitch|longest-streak|markdown-table|ccount|escape-string-regexp|character-entities|decode-named-character-reference|lodash-es|nanoid|entities|orderedmap|rope-sequence|w3c-keyname|style-mod|crelt)/)",
					"/node_modules/@react-native/babel-preset/"
				],
				"moduleNameMapper": {
					"^dedent$": "<rootDir>/../../node_modules/.pnpm/node_modules/dedent/dist/dedent.js"
				}
			}
		]
	}
}
